DATABASE_URL=postgresql://ge:ge@localhost:5432/ge
# Required to run `npm test` — the suite refuses to start without it so that a
# stray test run can never truncate the development database.
TEST_DATABASE_URL=postgresql://ge:ge@localhost:5432/ge_test

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
BCRYPT_COST=12
SPAWN_SECTOR_X=0
SPAWN_SECTOR_Y=0
ROSTER_MAX=20

# Midnight maintenance job (game/midnight/)
MIDNIGHT_MAILDAYS=7
MIDNIGHT_CHGLOSER=100
# Set to enable POST /admin/midnight/run (Bearer token). Unset => endpoint 503s.
MIDNIGHT_ADMIN_TOKEN=dev-midnight-token
