DATABASE_URL=postgresql://ge:ge@localhost:5432/ge
# Required to run `npm test` — the suite refuses to start without it so that a
# stray test run can never truncate the development database.
TEST_DATABASE_URL=postgresql://ge:ge@localhost:5432/ge_test

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
BCRYPT_COST=12
SPAWN_SECTOR_X=0
SPAWN_SECTOR_Y=0
ROSTER_MAX=20

# Midnight maintenance job (game/midnight/)
MIDNIGHT_MAILDAYS=7
MIDNIGHT_CHGLOSER=100
# Set to enable POST /admin/midnight/run (Bearer token). Unset => endpoint 503s.
MIDNIGHT_ADMIN_TOKEN=dev-midnight-token

# Dev-only cheat endpoints (/debug/ship/outfit, /debug/ship/credits,
# /debug/droid/spawn, /debug/cybertron-stats, /debug/tick-stats).
#
# These have NO authentication and act on a ship by NAME, so anyone who can
# reach the port can teleport another player's ship, swap its hull class, zero
# its damage, hand themselves ordnance or rewrite any captain's balance. They
# are OFF unless set here, and refuse to mount at all when NODE_ENV=production.
# `npm run start:dev` turns them on; `npm start` does not. Never set this on a
# host reachable by players.
# GE_DEBUG_ENDPOINTS=1

# Sysop allowlist for the `sys` command (canon GECMDS.C:4752-4760 gates it
# behind ISYSOP; an ungated `sys unjam` lets any player cancel being jammed).
# Comma-separated USERNAMES, matched case-insensitively — not userids, which are
# random per registration and change on every database reset. Unset means nobody
# is a sysop and every player gets canon's "Huh?".
# GE_SYSOP_USERNAME=YourName

# ─── Runtime / infrastructure ────────────────────────────────────────────────
# These are ENVIRONMENT ONLY and must never move into config/game.config.json,
# which is committed to git. Secrets belong in the deployment's environment.

# HTTP port the NestJS server listens on. Default 3000.
PORT=3000

# IANA timezone the midnight job runs against. Default UTC.
# GAME_TIMEZONE=America/New_York

# Path to the sysop tuning file. Set this in a container so the location is
# explicit rather than derived; it is checked BEFORE the four derived paths.
# Without it the resolver looks in <app root>/config/game.config.json.
# GE_CONFIG_PATH=/config/game.config.json

# *** MUST BE UNSET IN PRODUCTION ***
# Mounts /debug/* cheat routes that take a ship NAME and have NO authentication.
# Anyone who can reach the port can teleport, re-hull, repair or bankroll any
# ship in the galaxy. main.ts logs a loud warning when this is on.
# GE_DEBUG_ENDPOINTS=1

# The account treated as sysop by the `sys` command.
# GE_SYSOP_USERNAME=rick

# Runtime invariant checks — expensive, for debugging only.
# INVARIANTS_RUNTIME=1

# ─── Game tuning ─────────────────────────────────────────────────────────────
# Every canon sysop option is settable by its OWN name (UNIVMAX, SCRFACT,
# MAILDAYS, CLENGUSE, ...) — see SYSOP_OPTIONS in src/game/config/game-config.ts
# for all 57, with canon defaults and clamp bounds. Prefer config/game.config.json
# for anything permanent; declare deviations there, not here.
#
# Deterministic seeds, for reproducing a galaxy or an AI run.
# GALAXY_SEED=12345
# CYBERTRON_BOOT_SEED=12345
#
# Planet scoring divisors. Canon PLTVCASH 10, PLTVDIV 10000 (MBMGEMSG.MSG).
# PLTVCASH=10
# PLTVDIV=10000
