{
  "name": "galactic-empire-reborn-backend",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "db:reset": "PGPASSWORD=ge psql -v ON_ERROR_STOP=1 -h localhost -U ge -d postgres -c 'DROP DATABASE IF EXISTS ge;' -c 'CREATE DATABASE ge OWNER ge;' -c 'DROP DATABASE IF EXISTS ge_test;' -c 'CREATE DATABASE ge_test OWNER ge;' && npx prisma migrate deploy && npx prisma db seed",
    "test": "vitest run",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware .",
    "test:manual": "vitest run -c vitest.manual.config.ts",
    "prisma:generate": "prisma generate",
    "start": "nest start",
    "start:dev": "GE_DEBUG_ENDPOINTS=1 nest start --watch",
    "build": "nest build"
  },
  "dependencies": {
    "@ge/wire": "file:../packages/wire",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.2.5",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^11.2.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
