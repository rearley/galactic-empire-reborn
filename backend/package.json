{
  "name": "galactic-empire-reborn-backend",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "db:reset": "PGPASSWORD=ge psql -v ON_ERROR_STOP=1 -h localhost -U ge -d postgres -c 'DROP DATABASE IF EXISTS ge;' -c 'CREATE DATABASE ge OWNER ge;' -c 'DROP DATABASE IF EXISTS ge_test;' -c 'CREATE DATABASE ge_test OWNER ge;' && npx prisma migrate deploy && npx prisma db seed",
    "test": "jest",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware .",
    "test:manual": "jest --config jest.manual.config.ts",
    "prisma:generate": "prisma generate",
    "start": "nest start",
    "start:dev": "GE_DEBUG_ENDPOINTS=1 nest start --watch",
    "build": "nest build"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.15",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "@ge/wire": "file:../packages/wire"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.5.1",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
