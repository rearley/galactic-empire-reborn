  "comms": {
    "body": [
      "Comms & Fleet",
      "  hel [topic]            — this help; bare "hel" lists every topic",
      "  who                    — who is in the galaxy",
      "  dat <fragment>         — look up ship by name fragment",
      "  ros [all]              — score roster (only pilots who have scored)",
